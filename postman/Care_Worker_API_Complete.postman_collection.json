									"    if (response.success && response.data.token) {",
									"        pm.collectionVariables.set('careWorkerToken', response.data.token);",
									"        pm.collectionVariables.set('authToken', response.data.token);",
									"        console.log('Kiaan Technology token saved:', response.data.token);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"careworker1@example.com\",\n    \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "login"]
						},
						"description": "Login as Kiaan Technology\n\n**Credentials:**\n- Email: careworker1@example.com\n- Password: password123\n\n**Response:** Returns JWT token (automatically saved to careWorkerToken variable)"
					},
					"response": []
